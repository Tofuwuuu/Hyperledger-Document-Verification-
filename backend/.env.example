MONGODB_URL=mongodb://localhost:27017/cvsu_alumni
MONGODB_URI=

# JWT HMAC secret. Replace locally. Do not commit backend/.env.
SECRET_KEY=change_me

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENV=development

# false (default in code and in docker-compose.yml) uses the in-memory mock ledger.
# true calls FABRIC_GATEWAY_URL. Compose does not load this file into the backend container.
USE_REAL_BLOCKCHAIN=false
FABRIC_GATEWAY_URL=http://localhost:3001
CHANNEL_NAME=alumni-channel
CHAINCODE_NAME=final-smart-contract
