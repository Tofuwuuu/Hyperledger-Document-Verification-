MONGODB_URL=mongodb://localhost:27017/cvsu_alumni
MONGODB_URI=

# Required. Signs access tokens. The backend refuses to start if this is empty,
# shorter than 32 characters, or a placeholder like change_me.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not commit backend/.env.
SECRET_KEY=

# Access token lifetime in minutes. Logout ends every earlier token for that user.
ACCESS_TOKEN_MINUTES=60

# Refreshing extends a session, but never past this many hours after sign-in.
SESSION_MAX_HOURS=12

# Comma-separated proxy IPs or CIDRs whose X-Forwarded-For header is trusted
# for rate limiting. Leave empty unless the API runs behind a known proxy.
TRUSTED_PROXIES=

# The demo sends no email, so password reset stays off unless this is true.
PASSWORD_RESET_ENABLED=false

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENV=development

# false (default in code and in docker-compose.yml) uses the in-memory mock ledger.
# true calls FABRIC_GATEWAY_URL. Compose does not load this file into the backend container.
USE_REAL_BLOCKCHAIN=false
FABRIC_GATEWAY_URL=http://localhost:3001
CHANNEL_NAME=alumni-channel
CHAINCODE_NAME=final-smart-contract
