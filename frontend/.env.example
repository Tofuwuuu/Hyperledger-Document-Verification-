# API origin. frontend/src/config.js also accepts VITE_API_ORIGIN
# and strips a trailing /api/v1 if you include it.
# Leave both empty (or set VITE_PREVIEW_MODE=true) for a UI preview build
# that sends no requests to any API.
VITE_API_URL=http://localhost:8000

# Used by frontend/src/services/polling.js (milliseconds).
VITE_POLLING_INTERVAL=5000

# VITE_PREVIEW_MODE=true
