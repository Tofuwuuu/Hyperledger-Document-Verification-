# Host-side defaults. docker-compose.yml overrides these inside the container
# with /crypto mounts. Paths below are relative to fabric-gateway/ and only
# exist after fabric-network/network-up.ps1 generates organizations/.

PORT=3001
PEER_ENDPOINT=peer0.org1.example.com:7051
PEER_HOST_ALIAS=peer0.org1.example.com
PEER_TLS_ROOTCERT=../fabric-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
MSP_ID=Org1MSP
CHANNEL_NAME=alumni-channel
CHAINCODE_NAME=final-smart-contract
CERT_PATH=../fabric-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts
KEY_DIR=../fabric-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore
